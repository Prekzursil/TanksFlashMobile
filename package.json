{
  "name": "tanks-flash-mobile",
  "private": true,
  "scripts": {
    "sync:versions": "node scripts/sync_versions.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web test",
    "lint:web": "npm --prefix apps/web run lint",
    "format:web": "npm --prefix apps/web run format",
    "format:check:web": "npm --prefix apps/web run format:check",
    "dev:remake-web": "npm --prefix apps/remake-web run dev",
    "build:remake-web": "npm --prefix apps/remake-web run build",
    "test:remake-web": "npm --prefix apps/remake-web test",
    "lint:remake-web": "npm --prefix apps/remake-web run lint",
    "format:remake-web": "npm --prefix apps/remake-web run format",
    "format:check:remake-web": "npm --prefix apps/remake-web run format:check",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "sync:web:desktop": "npm --prefix apps/desktop run sync:web",
    "package:win": "npm --prefix apps/desktop run package:win",
    "cap:sync": "npm --prefix apps/web run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "assets:generate": "python3 scripts/generate_branding_assets.py",
    "assets:extract:original": "node scripts/extract_original_assets.mjs --write-web --write-godot --force",
    "swf:import": "node ./scripts/import_swf.mjs",
    "sync:swf:web": "npm --prefix apps/web run sync:swf",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "27.4.0",
    "lodash": "^4.17.23",
    "swf-extract": "^1.1.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@xmldom/xmldom@0.9": ">=0.9.12 <0.10.0",
    "bl": "1.2.3",
    "brace-expansion@1": ">=1.1.21 <2.0.0",
    "brace-expansion@2": ">=2.1.7 <3.0.0",
    "brace-expansion@5": ">=5.0.12 <6.0.0",
    "esbuild": "0.28.1",
    "glob@10": ">=14.0.2 <15.0.0",
    "glob@13": ">=14.0.2 <15.0.0",
    "minimatch@10": ">=11.0.1 <12.0.0",
    "nanoid@3": ">=3.3.18 <4.0.0",
    "postcss": ">=8.5.18 <9.0.0",
    "source-map-js": ">=1.2.2 <2.0.0",
    "tar": ">=7.5.22 <8.0.0"
  }
}
