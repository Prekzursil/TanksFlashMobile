{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:ruffle": "node ./scripts/sync_ruffle.mjs",
    "sync:swf": "node ./scripts/sync_swf.mjs",
    "predev": "npm run sync:ruffle && npm run sync:swf",
    "prebuild": "npm run sync:ruffle && npm run sync:swf",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node ./scripts/smoke_test.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "typescript-eslint": "8.54.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
