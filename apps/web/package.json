{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:ruffle": "node ./scripts/sync_ruffle.mjs",
    "sync:swf": "node ./scripts/sync_swf.mjs",
    "predev": "npm run sync:ruffle && npm run sync:swf",
    "prebuild": "npm run sync:ruffle && npm run sync:swf",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node ./scripts/smoke_test.mjs",
    "e2e:chromatic": "playwright test --config ./playwright.chromatic.config.ts ./e2e/chromatic/game-shell.spec.ts",
    "e2e:applitools": "playwright test --config ./playwright.chromatic.config.ts ./e2e/applitools-core-routes.spec.ts --project=chromium --workers=1",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.4.1"
  },
  "devDependencies": {
    "@applitools/eyes-playwright": "^1.47.15",
    "@chromatic-com/playwright": "^0.14.11",
    "@playwright/test": "1.62.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "chromatic": "^16.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "brace-expansion@1": ">=1.1.16 <2.0.0",
    "brace-expansion@2": ">=2.1.2 <3.0.0",
    "brace-expansion@5": ">=5.0.8 <6.0.0",
    "esbuild": "0.28.1",
    "fast-uri": ">=3.1.4 <4.0.0",
    "fast-xml-parser": ">=5.10.1 <6.0.0",
    "find-my-way": ">=9.7.0 <10.0.0",
    "js-yaml": ">=4.3.0 <5.0.0",
    "postcss": ">=8.5.18 <9.0.0",
    "sharp": ">=0.35.0 <0.36.0",
    "shell-quote": ">=1.9.0 <2.0.0",
    "storybook": "8.6.17",
    "uuid": "11.1.1"
  }
}
