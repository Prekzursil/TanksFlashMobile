{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:ruffle": "node ./scripts/sync_ruffle.mjs",
    "sync:swf": "node ./scripts/sync_swf.mjs",
    "predev": "npm run sync:ruffle && npm run sync:swf",
    "prebuild": "npm run sync:ruffle && npm run sync:swf",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node ./scripts/smoke_test.mjs",
    "e2e:chromatic": "playwright test --config ./playwright.chromatic.config.ts ./e2e/chromatic/game-shell.spec.ts",
    "e2e:applitools": "playwright test --config ./playwright.chromatic.config.ts ./e2e/applitools-core-routes.spec.ts --project=chromium --workers=1",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.4.1"
  },
  "devDependencies": {
    "@applitools/eyes-playwright": "^1.47.13",
    "@chromatic-com/playwright": "^0.14.11",
    "@playwright/test": "1.62.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "chromatic": "^16.0.0",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@storybook/core": "8.6.19",
    "@xmldom/xmldom@0.8": ">=0.8.15 <0.9.0",
    "basic-ftp": ">=6.2.1 <7.0.0",
    "brace-expansion@1": ">=1.1.21 <2.0.0",
    "brace-expansion@2": ">=2.1.7 <3.0.0",
    "brace-expansion@5": ">=5.0.12 <6.0.0",
    "deepmerge-ts": ">=8.0.0 <9.0.0",
    "esbuild": "0.28.1",
    "fast-uri": ">=3.1.8 <4.0.0",
    "fast-xml-parser": ">=5.12.1 <6.0.0",
    "fastify": ">=5.12.5 <6.0.0",
    "find-my-way": ">=9.7.0 <10.0.0",
    "glob@10": ">=14.0.2 <15.0.0",
    "ip-address@10": ">=10.7.5 <11.0.0",
    "js-yaml": ">=4.3.2 <5.0.0",
    "minimatch@10": ">=11.0.1 <12.0.0",
    "nanoid@3": ">=3.3.18 <4.0.0",
    "postcss": ">=8.5.18 <9.0.0",
    "sharp": ">=0.35.5 <0.36.0",
    "shell-quote": ">=1.12.0 <2.0.0",
    "source-map-js": ">=1.2.2 <2.0.0",
    "storybook": "8.6.19",
    "undici@6": ">=6.28.1 <7.0.0",
    "undici@7": ">=7.29.1 <8.0.0",
    "uuid": "11.1.1"
  }
}
