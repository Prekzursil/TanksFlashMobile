{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron wrapper for the Tanks Flash web build",
  "author": "Prekzursil",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prekzursil/TanksFlashMobile.git"
  },
  "main": "main.cjs",
  "scripts": {
    "sync:web": "node ./scripts/sync_web_dist.mjs",
    "dev": "node ./scripts/dev.mjs",
    "start": "electron .",
    "package:dir": "npm run sync:web && electron-builder --dir --publish never",
    "package:win": "npm run sync:web && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "brace-expansion@1": ">=1.1.16 <2.0.0",
    "brace-expansion@2": ">=2.1.2 <3.0.0",
    "brace-expansion@5": ">=5.0.8 <6.0.0",
    "fast-uri": ">=3.1.5 <4.0.0",
    "js-yaml": ">=4.3.0 <5.0.0",
    "tar": ">=7.5.22 <8.0.0"
  },
  "build": {
    "appId": "com.prekzursil.tanks",
    "productName": "Tanks",
    "copyright": "Copyright (c) 2026 Prekzursil",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tanks",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
