  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.3.7"
  },
  "overrides": {
    "brace-expansion@1": ">=1.1.21 <2.0.0",
    "brace-expansion@2": ">=2.1.7 <3.0.0",
    "brace-expansion@5": ">=5.0.12 <6.0.0",
    "esbuild": "0.28.1",
    "glob@10": ">=14.0.2 <15.0.0",
    "glob@13": ">=14.0.2 <15.0.0",
    "js-yaml": ">=4.3.2 <5.0.0",
    "minimatch@10": ">=11.0.1 <12.0.0",
    "nanoid@3": ">=3.3.18 <4.0.0",
    "postcss": ">=8.5.18 <9.0.0",
    "source-map-js": ">=1.2.2 <2.0.0"
